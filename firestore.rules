rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      // your-email@gmail.com-ai ungada Gmail-aa maathunga (firebase-config.js-ilum athe)
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['your-email@gmail.com'];
    }

    function str(f, max) { return f is string && f.size() <= max; }

    function validTemple(d) {
      return d.keys().hasOnly(['name','village','district','gs','priest','mobile','address','map',
                               'specials','history','collector','photo','createdAt'])
        && str(d.name, 150) && d.name.size() > 0
        && str(d.village, 100) && d.village.size() > 0
        && str(d.district, 40) && d.district.size() > 0
        && str(d.collector, 100) && d.collector.size() > 0
        && str(d.gs, 100) && str(d.priest, 100) && str(d.mobile, 16)
        && str(d.address, 200) && str(d.map, 400)
        && str(d.specials, 1500) && str(d.history, 3000)
        && str(d.photo, 900000)
        && d.createdAt == request.time;
    }

    match /temples/{id} {
      allow create: if validTemple(request.resource.data);   // yaar vendumaanaalum puthu pathivu seyyalaam
      allow read, update, delete: if isAdmin();               // paakka / neekka: admin mattum
    }
  }
}
